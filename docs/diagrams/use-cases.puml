@startuml
!pragma layout smetana
left to right direction
skinparam backgroundColor #FAFCF8
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam actorStyle awesome
title ChargeSlot - Cas d'utilisation
actor Conducteur
actor "Opérateur de station" as Operator
actor "Fournisseur de notifications\n(adaptateur local dans le TP)" as Notifications
rectangle ChargeSlot {
  usecase "UC1\nConsulter les disponibilités" as UC1
  usecase "UC2\nRéserver un créneau" as UC2
  usecase "UC3\nVérifier les conflits" as UC3
  usecase "UC4\nAnnuler une réservation" as UC4
  usecase "UC5\nNotifier le conducteur" as UC5
  usecase "UC6\nGérer stations, connecteurs\net maintenances" as UC6
}
Conducteur --> UC1
Conducteur --> UC2
Conducteur --> UC4
Operator --> UC1
Operator --> UC2 : pour un conducteur
Operator --> UC4
Operator --> UC6
UC2 ..> UC3 : <<include>>
UC2 ..> UC5 : <<include>>
UC4 ..> UC5 : <<include>>
Notifications -- UC5
note bottom of UC3
  Sous-fonction obligatoire de UC2.
  Le système n'est pas un acteur externe.
end note
@enduml
